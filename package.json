{
  "name": "ce4csid-toolkit-v2",
  "version": "2.0.0",
  "private": true,
  "description": "CE4CSID Community Engagement Toolkit — static site with a zero-runtime-dependency front end. Dev tooling only.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/",
    "test:coverage": "c8 --all --include=assets/js/**/*.js --lines 80 --functions 80 --branches 80 --statements 80 --reporter=text --reporter=lcov node --test tests/",
    "audit": "npm audit --audit-level=moderate",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test:coverage && npm run audit",
    "build:pages": "python3 tools/build_pages.py",
    "build:zip": "python3 tools/build_downloads_zip.py"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "c8": "^12.0.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.10.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "minimatch": "^11.0.1",
    "glob": "^14.0.2"
  }
}
